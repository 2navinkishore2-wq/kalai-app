{
  "name": "kalai-digital",
  "private": true,
  "version": "1.7.0",
  "description": "KALAI DIGITAL - Professional billing and business management for printing, flex, photo frame and digital printing",
  "author": "KALAI DIGITAL",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "electron:dev": "concurrently -k \"vite --port 5176\" \"wait-on tcp:127.0.0.1:5176 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5176 electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run build && cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "android:release": "npm run build && cap sync android && cd android && .\\gradlew.bat assembleRelease",
    "android:shas": "node scripts/android-shas.mjs",
    "cloud:verify": "tsx scripts/verify-cloud.ts"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capgo/capacitor-social-login": "^6.0.1",
    "@fontsource/inter": "^5.0.18",
    "@fontsource/noto-sans-tamil": "^5.1.0",
    "decimal.js": "^10.4.3",
    "firebase": "^10.12.0",
    "html2canvas-pro": "^1.5.8",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "~5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.kalaidigital.billing",
    "productName": "KALAI DIGITAL",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "KALAI-DIGITAL-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "KALAI DIGITAL",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
